# Obsidian — trạng thái local, không cần đồng bộ qua Git
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace.json.bak
.obsidian/cache

# Obsidian Git plugin — file runtime, không phải config
.obsidian/plugins/obsidian-git/*.log

# Plugin binary/bundle — code vendor, cài lại được qua Community Plugin Browser.
# Giữ lại manifest.json/data.json để biết plugin nào cần cài.
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css

# macOS
.DS_Store

# Obsidian trash (khi bật "move deleted files to .trash")
.trash/

# Log files
*.log
